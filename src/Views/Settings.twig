{% set codeLists = [
  ['hlthcr/hazards', 'fas fa-triangle-exclamation', translate('Hazards and exam intervals')],
  ['hlthcr/clinics', 'fas fa-house-medical', translate('Clinics and their medical staff')],
  ['hlthcr/cars', 'fas fa-car', translate('Cars')],
] %}

<div class="flex items-center">
  <h1 class="app-main-title">{{ translate('Code lists') }} > {{ translate('Settings') }}</h1>
</div>

<div class="card mt-10 w-1/2 m-auto">
  <div class="card-body">
    <p class="mb-4">{{ translate('The code lists shared by all Hlthcr apps. Exam intervals of the hazards set the next exam date.') }}</p>
    <div class="flex gap-2 flex-wrap">
      {% for codeList in codeLists %}
        <a href="{{ config.projectUrl }}/{{ codeList[0] }}" class="btn btn-transparent">
          <span class="icon"><i class="{{ codeList[1] }}"></i></span>
          <span class="text">{{ codeList[2] }}</span>
        </a>
      {% endfor %}
    </div>
  </div>
</div>
